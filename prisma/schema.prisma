// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  password String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Category {
  id    Int    @id @default(autoincrement())
  title String
  description String
  // relations
  companies Company[]
  products Product[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("categories")
}

model Company {
  id    Int    @id @default(autoincrement())
  name  String 
  percentage Int

  // relations
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([categoryId])
  @@map("companies")
}

model Product {
  id     Int    @id @default(autoincrement())
  title  String 
  author String
  description String
  price Int
  originalPrice Int
  discountedPrice Int
  quantity Int
  isbn String
  pages Int
  language String
  publisher String
  inStock Boolean @default(true)
  off  Int @default(0)
  isActive Boolean @default(true)
  
  // Foreign keys
  categoryId      Int
  companyId       Int

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([categoryId])
  @@index([inStock])
  @@index([createdAt])
  @@map("products")
}